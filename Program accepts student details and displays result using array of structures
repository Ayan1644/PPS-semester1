#include <stdio.h>

#define MAX_STUDENTS 100

struct Student
{
    int roll_no;
    char name[50];
    int marks1;
    int marks2;
    int marks3;
    int total;
    float percentage;
};

int main()
{
    struct Student students[MAX_STUDENTS];
    int n, i;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_STUDENTS)
    {
        printf("Invalid number of students.\n");
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        printf("\nEnter details of student %d:\n", i + 1);

        printf("Enter roll number: ");
        scanf("%d", &students[i].roll_no);

        printf("Enter name: ");
        scanf(" %49[^\n]", students[i].name);

        printf("Enter marks of Subject 1: ");
        scanf("%d", &students[i].marks1);

        printf("Enter marks of Subject 2: ");
        scanf("%d", &students[i].marks2);

        printf("Enter marks of Subject 3: ");
        scanf("%d", &students[i].marks3);

        students[i].total = students[i].marks1
                          + students[i].marks2
                          + students[i].marks3;

        students[i].percentage = students[i].total / 3.0f;
    }

    printf("\n\nStudent Result\n");

    printf("%-10s %-20s %-12s %-12s %-12s %-10s %-12s\n",
           "Roll No", "Name", "Subject 1", "Subject 2",
           "Subject 3", "Total", "Percentage");

    printf("-------------------------------------------------------------------------------\n");

    for (i = 0; i < n; i++)
    {
        printf("%-10d %-20s %-12d %-12d %-12d %-10d %-12.2f\n",
               students[i].roll_no,
               students[i].name,
               students[i].marks1,
               students[i].marks2,
               students[i].marks3,
               students[i].total,
               students[i].percentage);
    }

    return 0;
}

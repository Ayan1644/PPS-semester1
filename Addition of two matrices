#include <stdio.h>

int main()
{
    int a[3][3], b[3][3], sum[3][3];
    int rows, cols, i, j, choice;

    while(1)
    {
        printf("\n===== MATRIX ADDITION CALCULATOR =====\n");
        printf("1. Add Two Matrices\n");
        printf("2. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if(choice == 2)
        {
            printf("Stopping calculator\n");
            break;
        }

        if(choice != 1)
        {
            printf("Invalid choice,select 1 or 2.\n");
            continue;
        }

        printf("\nEnter number of rows (1-3): ");
        scanf("%d", &rows);

        printf("Enter number of columns (1-3): ");
        scanf("%d", &cols);

        if(rows < 1 || rows > 3 || cols < 1 || cols > 3)
        {
            printf("Invalid size,Choose rows and columns between 1 and 3.\n");
            continue;
        }

        printf("\nEnter elements of first matrix:\n");
        for(i = 0; i < rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                printf("Enter element [%d][%d]: ", i + 1, j + 1);
                scanf("%d", &a[i][j]);
            }
        }

        printf("\nEnter elements of second matrix:\n");
        for(i = 0; i < rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                printf("Enter element [%d][%d]: ", i + 1, j + 1);
                scanf("%d", &b[i][j]);
            }
        }

        for(i = 0; i < rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                sum[i][j] = a[i][j] + b[i][j];
            }
        }

        printf("\nAddition of two matrices is:\n");
        for(i = 0; i < rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                printf("%d\t", sum[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
